    <body>
        
    
    <style>
    body
    { text-align: center; background-color: #809176;}
        input{
            margin-left: 2%;
            margin-bottom: 12px;
        }

    </style>
        <h1 style="flex: 1; padding: 9px; color: #174b19; font-size: 34px; text-align: center;">Starting just for practice ,to <br>know how capable i'm  </h1><br>
        <form action="/submit" method="post">
                <br>
                
                <label for="fname"> full name</label>
                <input type="text" name="fname" id="fname" placeholder="Name" required><br>
                
                <label for="email">email</label>
                <input type="text" name="email" id="email" placeholder="e-mail" required><br>

                <label for="phone">phone</label>
                <input type="tel" name="phone" id="phone" placeholder="***" required><br>

                <label for="dob">Date of birth</label>
                <input type="date" name="dob" id="dob"><br>

                <label for="password">password</label>
                <input type="password" name="password" id="password" minlength="6" pattern="2" placeholder="password" required><br>

                <label for="age">age</label>
                <input type="number" name="number" id="number" min="8" max="100+" placeholder="***" required><br>
                
                <label for="country">country</label>
                <select name="country" id="country" required>
                    <option value="">***</option>
                    <option value="pak">Pakistan</option>
                    <option value="Aus">Australia</option>
                    <option value="Afg">Afghanistan</option>
                </select><br>
                 <p>Gender</p>
                <input type="radio" name="gender" id="Male" value="Male">
                <label for="male">Male</label>
                <input type="radio" name="gender" id="female" value="female">
                <label for="female">Female</label>
                <p>Good At</p>
                <input type="checkbox" name="Good_At" id="communication_skill" value="communication_skill">
                <label for="communication_skill">communication skill</label>

                




                    
        </form>
