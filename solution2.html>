<!DOCTYPE html>
<html lang="eng">
<head>
    <meta charset="8">
    <title>Product Card</title>
</head>
  
<body style="font-family: Arial, sans-serif; background: #f5f5f5; margin: 0; padding: 40px 20px;">

  <div style="max-width: 400px; margin: 0 auto; background: white; border-radius: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.1); overflow: hidden;">

    <img src="https://via.placeholder.com/400x250" alt="Wireless Headphones" style="padding: 25px;">
    
    <div style="padding: 25px;">
      
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px;">
        <h2 style="margin: 0; color: #333; font-size: 22px;">Wireless Headphones</h2>
        <span style="color: #e91e63 ; font-weight: bold; font-size: 20px;">$79.99</span>
      </div>

      <p style="color: #666; line-height: 1.6; margin: 0 0 15px 0;">Premium sound quality with noise cancellation and 30-hour battery life.</p>

      <div style="display: flex; gap: 10px; margin-bottom: 20px;">
        <span  style="background: #e3f2fd; color: #1976d2; padding: 5px 12px;border-radius: 15px; font-size: 12px;"> Noise Cancelling</span>
        <span style="background: #e3f2fd; color: #1976d2; padding: 5px 12px;border-radius: 15px; font-size: 12px;"> Bluetooth 5.0px </span>
        <span style="background: #e3f2fd; color: #1976d2; padding: 5px 12px;border-radius: 15px; font-size: 12px;"> 30h Battery </span> 
        
      </div>

      <table style="width: 100%; border-collapse: collapse; margin-bottom: 20px;">
        <tr>
          <th style="border: 1px solid #ddd; padding: 8px; background: #f9f9f9; text-align: left;">Color</th>
          <th style="border: 1px solid #ddd; padding: 8px; background: #f9f9f9; text-align: left;">Stock</th>
        </tr>
        <tr>
          <td style="border: 1px solid #ddd; padding: 8px;">Black</td>
          <td style="border: 1px solid #ddd; padding: 8px; color: green;">In Stock</td>
        </tr>
        <tr>
          <td style="border: 1px solid #ddd; padding: 8px;">White</td>
          <td style="border: 1px solid #ddd; padding: 8px; color: red;">Out of Stock</td>
        </tr>
      </table>

      <div style="display: flex; gap: 10px;">
        <button style="flex: 1; padding: 12px; background: #4caf50; color: white; border: none; border-radius: 8px; font-size: 16px; cursor: pointer;" ->Add to Card</button>
       
       <a href="#details" style="flex: 1; padding: 12px; background: white; color: #4caf50; border: 2px solid #4caf50; border-radius: 8px; font-size: 16px; text-align: center; text-decoration: none;">Details</a> 
      </div>

    </div>
  </div>
    
</body>
</html>
